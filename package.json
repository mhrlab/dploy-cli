{
  "name": "dploy-cli",
  "version": "2.2.4",
  "description": "A powerful command-line tool for managing deployments, builds, and more for your projects. With dploy-cli, you can automate your deployment pipeline, build processes, and easily manage your project releases.",
  "private": false,
  "type": "module",
  "bin": {
    "dploy": "./dist/bin/dploy.js"
  },
  "files": [
    "dist/bin",
    "dist/src",
    "templates"
  ],
  "license": "MIT",
  "keywords": [
    "deploy",
    "deployment",
    "cli",
    "zero-downtime",
    "ssh",
    "sftp",
    "nginx",
    "laravel",
    "nodejs"
  ],
  "homepage": "https://github.com/mhrlab/dploy-cli#readme",
  "bugs": {
    "url": "https://github.com/mhrlab/dploy-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhrlab/dploy-cli.git"
  },
  "author": {
    "name": "Hemant Kumar Meena",
    "url": "https://github.com/mhrlab"
  },
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsc -w",
    "test": "npm run build && node scripts/run-tests.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^13.1.0",
    "dotenv": "^16.4.5",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.2.0",
    "inquirer": "^12.9.4",
    "js-yaml": "^4.1.0",
    "ora": "^8.0.1",
    "ssh2": "^1.15.0",
    "ssh2-sftp-client": "^10.0.3",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.5.5",
    "@types/ssh2": "^1.15.5",
    "@types/ssh2-sftp-client": "^9.0.5",
    "typescript": "^5.5.4"
  },
  "allowScripts": {
    "ssh2@1.17.0": true
  }
}
