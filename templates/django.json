{
  "buildDir": "build",
  "strategy": "include",
  "include": ["myproject/**", "manage.py", "requirements.txt"],
  "shared": [".env", "media"],
  "sharedDefaults": { ".env": ".env.example" },
  "hooks": {
    "postDeploy": [
      "python3 -m venv venv",
      "venv/bin/pip install -r requirements.txt",
      "venv/bin/python manage.py migrate",
      "venv/bin/python manage.py collectstatic --noinput",
      "systemctl restart gunicorn"
    ]
  },
  "environments": {
    "production": {
      "host": "myserver.com",
      "username": "deploy",
      "deployTo": "/var/www/django-app",
      "keepVersions": 5
    }
  }
}
