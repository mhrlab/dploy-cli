{
  "name": "Node.js + PM2",
  "build": {
    "buildDir": "build",
    "strategy": "include",
    "include": [
      "dist/**",
      "package.json",
      "package-lock.json"
    ],
    "shared": [
      ".env"
    ],
    "sharedDefaults": {
      ".env": ".env.example"
    },
    "cleanAfterDeploy": true
  },
  "hooks": {
    "postDeploy": [
      "npm install --production",
      "pm2 restart ecosystem.config.js"
    ]
  },
  "environments": {
    "production": {
      "host": "myserver.com",
      "username": "deploy",
      "ssh_key_path": "~/.ssh/id_rsa",
      "deployTo": "/var/www/myapp",
      "keepVersions": 5
    }
  }
}
