# Environment variables for dploy-cli. Copy to .env.deploy and edit.


# Target environment name (when not passed via CLI)
DPLOY_ENV=production


# Connection (overrides can be set in dploy.config.json)
DPLOY_HOST=your.server.com
DPLOY_PORT=22
DPLOY_USER=ubuntu
# Either use key or password
DPLOY_PRIVATE_KEY=~/.ssh/id_rsa # path, will expand ~
# DPLOY_PASSWORD= # optional


# Base URL for health check (scheme+host)
DPLOY_BASE_URL=https://your.server.com
