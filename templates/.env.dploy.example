# Environment variables for dploy-cli. Copy to .env.dploy and edit.

# Target environment name (when not passed via --env)
DPLOY_ENV=staging

# Common SSH defaults (inherited by environments via deploy.config.yml)
SSH_PORT=22
SSH_KEY_PATH=~/.ssh/id_rsa
# DPLOY_PASSPHRASE=your_key_passphrase # If SSH key is encrypted
# SSH_PASSWORD=your_ssh_password       # If using password authentication

# Staging Environment
STAGING_HOST=staging.example.com
STAGING_USER=deploy
# STAGING_SSH_KEY_PATH=~/.ssh/id_rsa
# STAGING_PASSWORD=

# Production Environment
PROD_HOST=prod.example.com
PROD_USER=deploy
# PROD_SSH_KEY_PATH=~/.ssh/id_rsa
# PROD_PASSWORD=
# PROD_SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n..." # for CI/CD secrets

# Multi-server cluster example:
# CLUSTER_HOST_1=10.0.0.1
# CLUSTER_HOST_2=10.0.0.2

# Base URL for health check
DPLOY_BASE_URL=https://prod.example.com

# Webhook notifications (Slack, Discord, Telegram)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=-100123456789
