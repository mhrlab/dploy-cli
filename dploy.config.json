{
  "buildDir": "build",
  "cleanAfterDeploy": true,
  "copy": [
    { "from": "dist", "to": "dist" },
    { "from": "package.json", "to": "package.json" },
    { "from": "package-lock.json", "to": "package-lock.json", "optional": true },
    { "from": ".env.example", "to": ".env", "optional": true }
  ],
  "environments": {
    "local": {
      "deployTo": "/home/deploytest/apps/myapp",
      "keepVersions": 3,
      "healthCheckPath": "/health"
    }
  }

}