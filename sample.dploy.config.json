{
  "buildDir": "build",
  "strategy": "hybrid",
  "allowed": ["\"include\" | \"exclude\" | \"copy\" | \"hybrid\""],
  "include": ["dist/**", "public/**"],
  "exclude": ["**/*.test.js", "node_modules/**"],
  "copy": [
    { "from": "package.json", "to": "package.json" },
    { "from": ".env.example", "to": ".env", "optional": true }
  ],
  "shared": ["storage", ".env"],
  "sharedDefaults": { ".env": ".env.example" },
  "hooks": {
    "preBuild": ["echo 'Cleaning cache'"],
    "postBuild": ["echo 'Build finished'"],
    "preDeploy": ["echo 'About to deploy'"],
    "postDeploy": ["npm install --production", "pm2 restart myapp"]
  },
  "environments": {
    "production": {
      "deployTo": "/var/www/myapp",
      "keepVersions": 5,
      "healthCheckPath": "/health"
    }
  }
}